---
import ColorThemeSwitcher from './ColorThemeSwitcher';
import { baseUrl } from '../lib/utils';
import { footerColumns, links } from '../data/site';
import { buildData } from '../lib/buildData';

const year = new Date().getFullYear();
const href = (h: string, external?: boolean) => (external ? h : baseUrl(h));
---

<footer class="border-t border-line bg-surface-2">
  <div class="container-x py-14">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-6">
      <div class="col-span-2">
        <a href={baseUrl('')} class="flex items-center gap-2.5 no-underline">
          <img src={baseUrl('ipython-logo.png')} alt="" width="28" height="28" class="h-7 w-7 rounded" />
          <span class="text-lg font-bold text-ink">IPython</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-ink-muted">
          The interactive Python shell, and the kernel behind Jupyter. Free and open source since 2001.
        </p>
        <p class="mt-4 font-mono text-xs text-ink-faint">
          Latest release: <a href={links.pypi} class="text-ink-muted">{buildData.version}</a>
        </p>
      </div>
      {footerColumns.map((col) => (
        <div>
          <h2 class="text-xs font-semibold tracking-wide text-ink uppercase">{col.title}</h2>
          <ul class="mt-3 space-y-2">
            {col.items.map((item) => (
              <li>
                <a
                  href={href(item.href, item.external)}
                  class="text-sm text-ink-muted no-underline hover:text-ink hover:underline"
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
      <div class="text-sm text-ink-faint">
        <p>
          © {year} The IPython Development Team. Code is released under the
          <a href={links.license} class="text-ink-muted">BSD 3-Clause License</a>.
        </p>
        <p class="mt-1">
          IPython is a subproject of <a href={links.jupyter} class="text-ink-muted">Project Jupyter</a>,
          supported by the <a href={links.jupyterFoundation} class="text-ink-muted">Jupyter Foundation</a>.
        </p>
      </div>
      <div class="no-print">
        <ColorThemeSwitcher client:idle />
      </div>
    </div>
  </div>
</footer>
