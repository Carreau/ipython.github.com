---
/** A single shell command with a copy button. */
interface Props {
  command: string;
  /** Text shown above the block, optional. */
  label?: string;
  class?: string;
}
const { command, label, class: cls = '' } = Astro.props;
---

<div class:list={[cls]}>
  {label && <p class="mb-2 text-sm font-medium text-ink-muted">{label}</p>}
  <div class="cmd">
    <span class="cmd-prompt" aria-hidden="true">$</span>
    <code>{command}</code>
    <button type="button" class="copy-btn no-print" data-copy={command} aria-label={`Copy "${command}" to clipboard`}>Copy</button>
  </div>
</div>
