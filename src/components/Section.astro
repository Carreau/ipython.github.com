---
/**
 * A page section with the IPython prompt motif as eyebrow: `In [n]:`.
 * tone: "default" (page surface) | "alt" (tinted) | "accent" (theme-tinted band).
 */
interface Props {
  n?: number | string;
  id?: string;
  title?: string;
  lede?: string;
  tone?: 'default' | 'alt' | 'accent';
  /** Narrow (prose) width instead of the wide container. */
  narrow?: boolean;
  class?: string;
}
const { n, id, title, lede, tone = 'default', narrow = false, class: cls = '' } = Astro.props;
const toneClass = {
  default: 'bg-surface',
  alt: 'bg-surface-2 border-y border-line',
  accent: 'section-accent',
}[tone];
---

<section id={id} class:list={['py-16 sm:py-24', toneClass, cls]}>
  <div class:list={[narrow ? 'container-prose' : 'container-x']}>
    {(n !== undefined || title) && (
      <div class="mb-10 max-w-2xl">
        {n !== undefined && <p class="eyebrow mb-3">In [{n}]:</p>}
        {title && <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>}
        {lede && <p class="mt-4 text-lg text-ink-muted">{lede}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
