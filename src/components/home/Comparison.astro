---
import { comparisonColumns, comparisonRows, comparisonNote, type Cell } from '../../data/comparison';

function render(c: Cell): string {
  if (c === true) return '<span class="cmp-yes" aria-label="yes">✓</span>';
  if (c === false) return '<span class="cmp-no" aria-label="no">–</span>';
  return `<span class="cmp-note">${c}</span>`;
}
---

<div class="overflow-x-auto rounded-(--radius-card) border border-line">
  <table class="w-full min-w-[640px] text-sm">
    <thead>
      <tr class="bg-surface-2 text-left">
        <th class="px-4 py-3 font-semibold text-ink">Feature</th>
        {comparisonColumns.map((col, i) => (
          <th class:list={['px-4 py-3 font-semibold', i === 0 ? 'text-brand-text' : 'text-ink']}>{col.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {comparisonRows.map((row) => (
        <tr class="border-t border-line">
          <td class="px-4 py-2.5 text-ink-muted">{row.feature}</td>
          {comparisonColumns.map((col, i) => (
            <td class:list={['px-4 py-2.5', i === 0 && 'bg-brand-soft/60']} set:html={render(row[col.key])} />
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="mt-3 text-sm text-ink-faint">{comparisonNote}</p>

<style>
  .cmp-yes { color: var(--brand-text); font-weight: 700; font-size: 1rem; }
  .cmp-no { color: var(--ink-faint); }
  .cmp-note { color: var(--ink-muted); font-size: 0.8125rem; }
</style>
