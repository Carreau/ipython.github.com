---
/** Syntax-highlighted code (Python, shell, JSON…) rendered at build time with Shiki. */
import { Code } from 'astro:components';
interface Props {
  code: string;
  lang?: string;
  /** Optional filename or caption shown above the code. */
  title?: string;
  copy?: boolean;
  class?: string;
}
const { code, lang = 'python', title, copy = true, class: cls = '' } = Astro.props;
const trimmed = code.replace(/^\n+|\n+$/g, '');
---

<figure class:list={['codeblock relative', cls]}>
  {title && (
    <figcaption class="mb-2 flex items-center justify-between font-mono text-xs text-ink-faint">
      <span>{title}</span>
    </figcaption>
  )}
  <div class="relative">
    <Code code={trimmed} lang={lang as any} theme="github-dark-default" />
    {copy && (
      <button type="button" class="copy-btn no-print absolute top-2.5 right-2.5" data-copy={trimmed} aria-label="Copy code to clipboard">Copy</button>
    )}
  </div>
</figure>
