---
import ThemeToggle from './ThemeToggle';
import ColorThemeDropdown from './ColorThemeDropdown';
import { baseUrl } from '../lib/utils';
import { nav, links } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path.endsWith('/' + href);
---

<nav class="sticky top-0 z-50 border-b border-line bg-surface/85 backdrop-blur supports-[backdrop-filter]:bg-surface/70" aria-label="Main">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={baseUrl('')} class="flex items-center gap-2.5 no-underline" aria-label="IPython home">
      <img src={baseUrl('ipython-logo.png')} alt="" width="32" height="32" class="h-8 w-8 rounded" />
      <span class="text-lg font-bold tracking-tight text-ink">IPython</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={baseUrl(item.href)}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm font-medium no-underline transition',
            isActive(item.href) ? 'bg-surface-3 text-ink' : 'text-ink-muted hover:bg-surface-2 hover:text-ink',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <a href={links.docs} class="rounded-md px-3 py-1.5 text-sm font-medium text-ink-muted no-underline transition hover:bg-surface-2 hover:text-ink" target="_blank" rel="noopener">
        Docs<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true" class="text-ink-faint">↗</span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <a href={links.github} target="_blank" rel="noopener" class="rounded-lg p-2 text-ink-muted transition hover:bg-surface-2 hover:text-ink" aria-label="IPython on GitHub">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.72-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <ColorThemeDropdown client:idle />
      <ThemeToggle client:idle />
      <button id="mobile-menu-btn" class="rounded-lg p-2 text-ink-muted hover:bg-surface-2 md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden">
    <div class="container-x flex flex-col py-2">
      {nav.map((item) => (
        <a href={baseUrl(item.href)} class="rounded-md px-3 py-2.5 text-base font-medium text-ink no-underline hover:bg-surface-2" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={links.docs} class="rounded-md px-3 py-2.5 text-base font-medium text-ink no-underline hover:bg-surface-2" target="_blank" rel="noopener">Documentation ↗</a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
